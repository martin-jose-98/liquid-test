<li class="flex-none flex flex-col w-full md:w-[355px] snap-start group relative">
  <a href="{{ item.url }}" class="block">
    <div class="font-bebas bg-white border border-black rounded-full text-black text-[10px] px-[8px] py-[4px] inline-block w-fit absolute left-[16px] top-[12px] leading-none z-10">
      Best Seller
    </div>
    {% if item.tags contains "discount-15" %}
      <div class="font-bebas bg-[#5C7962] border border-black rounded-full text-white text-[10px] px-[8px] py-[4px] inline-block w-fit absolute right-[16px] top-[12px] leading-none z-10">
        SAVE 15%
      </div>
    {% endif %}
    <div class="relative aspect-square overflow-hidden bg-stone-100 rounded-[10px]">
      {{ item.featured_image | image_url: width: 3200 | image_tag:
        loading: 'lazy',
        widths: '350, 500, 700, 1000',
        sizes: '355px',
        alt: item.featured_image.alt,
        class: 'absolute inset-0 h-full w-full object-cover rounded-[10px] transition-opacity duration-300 opacity-100 group-hover:opacity-0'
      }}
      {% if item.images[1] %}
        {{ item.images[1] | image_url: width: 3200 | image_tag:
          loading: 'lazy',
          widths: '350, 500, 700, 1000',
          sizes: '355px',
          alt: item.images[1].alt,
          class: 'absolute inset-0 h-full w-full object-cover rounded-[10px] transition-opacity duration-300 opacity-0 group-hover:opacity-100'
        }}
      {% endif %}
    </div>
    <div class="mt-3">
      <h3 class="text-ink font-normal font-bebas text-md md:text-lg">{{ item.title }}</h3>
      <div class="flex gap-[3px] items-center">
        {% render 'icon-star' %}
        {% render 'icon-star' %}
        {% render 'icon-star' %}
        {% render 'icon-star' %}
        {% render 'icon-star' %}
        <span class="text-xs text-[#707070] font-poppins leading-tight ml-[1px]"> 1,234+ Reviews </span>
      </div>
      <p class="mt-1 text-sm text-olive text-base font-poppins font-medium">{{ item.price | money }}</p>
    </div>
  </a>
</li>

